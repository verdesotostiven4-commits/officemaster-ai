APP_NAME=OfficeMaster AI
APP_ENV=development
MAX_UPLOAD_MB=25
EXPORT_FORMATS=docx,pptx,xlsx,pdf

# OfficeMaster AI funciona gratis sin estas variables usando el motor interno.
# Variables opcionales para mejorar con IA externa:

# Gemini API opcional
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# OpenAI API opcional, requiere credito en OpenAI Platform
AI_API_KEY=
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini
